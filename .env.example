# ============================================================
# RAG-Law 环境变量样例
# 使用方法：复制为 .env 并填入真实值（.env 已被 .gitignore 忽略）
# 所有模型服务均通过「OpenAI 兼容接口」接入
# ============================================================

# ---------- 大模型（回答生成） ----------
# 服务地址示例：
#   阿里云百炼   https://dashscope.aliyuncs.com/compatible-mode/v1
#   硅基流动     https://api.siliconflow.cn/v1
#   智谱开放平台 https://open.bigmodel.cn/api/paas/v4
RAG_LAW_LLM_BASE_URL=
RAG_LAW_LLM_API_KEY=
RAG_LAW_LLM_MODEL=

# ---------- 向量模型（Embedding） ----------
# 可与大模型同服务商、同 Key；模型名按服务商文档填写
#   阿里云百炼示例：text-embedding-v3
#   硅基流动示例：  BAAI/bge-m3
RAG_LAW_EMBEDDING_BASE_URL=
RAG_LAW_EMBEDDING_API_KEY=
RAG_LAW_EMBEDDING_MODEL=

# ---------- 重排模型（Reranker） ----------
# 硅基流动示例：
#   BASE_URL=https://api.siliconflow.cn/v1
#   MODEL=BAAI/bge-reranker-v2-m3
RAG_LAW_RERANK_BASE_URL=
RAG_LAW_RERANK_API_KEY=
RAG_LAW_RERANK_MODEL=

# ---------- 多轮会话 ----------
# 最近多少轮（一次用户提问 + 一次助手回答）保留原文；更早内容自动总结
RAG_LAW_CONVERSATION_RECENT_ROUNDS=3
# 早期对话摘要的最大字符数
RAG_LAW_CONVERSATION_SUMMARY_MAX_CHARS=1500

# ---------- Web 前端（可选） ----------
# 默认已允许本地 Vite 开发地址；前端部署到其他域名时用逗号分隔填写。
# 生产环境由 FastAPI 同源托管页面，通常无需设置。
# RAG_LAW_CORS_ORIGINS=http://localhost:5173

# ---------- 登录与用户 ----------
# 账号库连接串（PostgreSQL）。留空时 /v1/auth/* 返回 503，业务接口一律拒绝。
RAG_LAW_DATABASE_URL=

# 会话 Cookie 名称
RAG_LAW_SESSION_COOKIE_NAME=rag_law_sid
# 登录保持时长（秒），默认 8 小时
RAG_LAW_SESSION_TTL_SECONDS=28800
# 走 HTTPS 部署时必须改为 true，否则浏览器不会回传 Cookie
RAG_LAW_SESSION_COOKIE_SECURE=false

# ---------- 历史对话 ----------
# 与账号库同库（复用 RAG_LAW_DATABASE_URL）；首次读写会自动建表，
# 受限账号请先执行 scripts/init_conversations_db.sql。
# 侧边栏一次最多列出多少个历史对话
RAG_LAW_CONVERSATION_HISTORY_LIMIT=50