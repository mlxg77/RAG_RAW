# ============================================================
# RAG-Law 环境变量样例
# 使用方法：复制为 .env 并填入真实值（.env 已被 .gitignore 忽略）
# 所有模型服务均通过「OpenAI 兼容接口」接入
# ============================================================

# ---------- 大模型（回答生成） ----------
# 服务地址示例：
#   阿里云百炼   https://dashscope.aliyuncs.com/compatible-mode/v1
#   硅基流动     https://api.siliconflow.cn/v1
#   智谱开放平台 https://open.bigmodel.cn/api/paas/v4
RAG_LAW_LLM_BASE_URL=
RAG_LAW_LLM_API_KEY=
RAG_LAW_LLM_MODEL=

# ---------- 向量模型（Embedding） ----------
# 可与大模型同服务商、同 Key；模型名按服务商文档填写
#   阿里云百炼示例：text-embedding-v3
#   硅基流动示例：  BAAI/bge-m3
RAG_LAW_EMBEDDING_BASE_URL=
RAG_LAW_EMBEDDING_API_KEY=
RAG_LAW_EMBEDDING_MODEL=

# ---------- 重排模型（Reranker） ----------
# 硅基流动示例：
#   BASE_URL=https://api.siliconflow.cn/v1
#   MODEL=BAAI/bge-reranker-v2-m3
RAG_LAW_RERANK_BASE_URL=
RAG_LAW_RERANK_API_KEY=
RAG_LAW_RERANK_MODEL=